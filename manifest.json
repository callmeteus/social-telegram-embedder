{
    "manifest_version": 3,
    "name": "__MSG_extName__",
    "version": "1.3.0",
    "description": "__MSG_extDescription__",
    "default_locale": "en",
    "minimum_chrome_version": "116",
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_title": "__MSG_extName__",
        "default_popup": "popup.html"
    },
    "permissions": [
        "storage",
        "notifications"
    ],
    "host_permissions": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://m.facebook.com/*",
        "https://*.fbcdn.net/*",
        "https://api.telegram.org/*",
        "https://api.fxtwitter.com/*",
        "https://pbs.twimg.com/*",
        "https://video.twimg.com/*",
        "https://e621.net/*",
        "https://e926.net/*",
        "https://*.e621.net/*",
        "https://*.e926.net/*",
        "https://tiktok.com/*",
        "https://www.tiktok.com/*",
        "https://vm.tiktok.com/*",
        "https://vt.tiktok.com/*",
        "https://*.tiktokcdn.com/*",
        "https://*.tiktokcdn-us.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://x.com/*",
                "https://twitter.com/*",
                "https://www.facebook.com/*",
                "https://web.facebook.com/*",
                "https://m.facebook.com/*",
                "https://tiktok.com/*",
                "https://www.tiktok.com/*",
                "https://vm.tiktok.com/*",
                "https://vt.tiktok.com/*",
                "https://e621.net/*",
                "https://e926.net/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "content.css"
            ],
            "run_at": "document_idle"
        }
    ],
    "options_page": "options.html"
}
