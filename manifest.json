{
    "manifest_version": 3,
    "name": "Social Telegram Embedder",
    "version": "1.1.0",
    "description": "Embed social posts in Telegram channels with rich media. X/Twitter supported today; more networks coming.",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://api.telegram.org/*",
        "https://api.fxtwitter.com/*",
        "https://pbs.twimg.com/*",
        "https://video.twimg.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://x.com/*",
                "https://twitter.com/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "content.css"
            ],
            "run_at": "document_idle"
        }
    ],
    "options_page": "options.html"
}
