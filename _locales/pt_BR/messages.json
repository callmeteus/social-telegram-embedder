    },
    "pickerSendShortcut": {
        "message": "$1 envia",
        "placeholders": {
            "shortcut": {
                "content": "$1",
                "example": "Ctrl+Enter"
            }
        }
    },
    "pickerClose": {
        "message": "Fechar"
    }
}
