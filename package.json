{
    "name": "social-telegram-embedder",
    "version": "1.0.0",
    "private": true,
    "description": "Chrome extension to embed social posts in Telegram channels with rich media",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/callmeteus/social-telegram-embedder.git"
    },
    "homepage": "https://github.com/callmeteus/social-telegram-embedder",
    "bugs": {
        "url": "https://github.com/callmeteus/social-telegram-embedder/issues"
    },
    "scripts": {
        "build": "node scripts/generate-icons.mjs && node scripts/build.mjs",
        "build:firefox": "node scripts/generate-icons.mjs && node scripts/build-firefox.mjs",
        "dev": "node scripts/dev.mjs",
        "dev:options": "vite --config vite.options.config.ts",
        "package:zip": "yarn build && node scripts/package.mjs",
        "package:firefox": "yarn build:firefox && node scripts/package-firefox.mjs",
        "test:firefox": "yarn build:firefox && node scripts/smoke-firefox.mjs",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "devDependencies": {
        "@playwright/test": "1.65.1",
        "@types/chrome": "^0.0.287",
        "@types/firefox-webext-browser": "^143.0.1",
        "archiver": "^7.0.1",
        "esbuild": "^0.25.0",
        "jsdom": "^26.0.0",
        "lucide-static": "^1.45.0",
        "playwright": "1.65.1",
        "playwright-webextext": "^0.0.5",
        "sharp": "^0.35.4",
        "tslib": "^2.9.1",
        "typescript": "^5.7.3",
        "vite": "^6.0.7",
        "vitest": "^2.1.8"
    },
    "dependencies": {
        "@mtcute/web": "0.32.4",
        "uqr": "0.1.3"
    }
}
